# Primary Gemini API Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional Multiple API Keys for KeyPool rotation (comma-separated):
# GEMINI_API_KEYS=KEY_SLOT_1,KEY_SLOT_2,KEY_SLOT_3

# Model Configuration
GENERATION_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=text-embedding-004

# RAG Retrieval Settings
TOP_K=5
TEMPERATURE=0.2
LOCAL_ONLY=false
